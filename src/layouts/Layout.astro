---
// src/layouts/Layout.astro
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/animations.css';
import '@fontsource-variable/inter/index.css';

import { sanityClient } from '../lib/sanity';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Portfolio di fotografia naturalistica" } = Astro.props;

// Il Layout fetcha i settings una volta sola: nome, tagline e social
// vengono usati da navbar e footer su ogni pagina.
const settings = await sanityClient.fetch(`
  *[_type == "siteSettings"][0] {
    photographerName,
    tagline,
    email,
    instagram,
    linkedin,
    facebook,
  }
`);
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
</head>

<body class="antialiased">

  <!-- ===================== NAVBAR ===================== -->
  <nav class="navbar" id="navbar">
    <div class="navbar__brand">
      <a href="/" class="navbar__logo-link">
        <span class="navbar__logo-name">
          {settings?.photographerName ?? 'Nome Fotografo'}
        </span>
        <span class="navbar__logo-sub">
          {settings?.tagline ?? 'Naturalist & Explorer'}
        </span>
      </a>
    </div>

    <ul class="navbar__links" id="nav-links">
      <li><a href="/" class="navbar__link">Portfolio</a></li>
      <li><a href="/archive" class="navbar__link">Archive</a></li>
      <li><a href="/info" class="navbar__link">Info</a></li>
      <li><a href="/info#contact" class="navbar__link navbar__link--cta">Contact</a></li>
    </ul>

    <button class="navbar__burger" id="nav-burger" aria-label="Apri menu">
      <span></span>
      <span></span>
    </button>
  </nav>

  <!-- Overlay mobile -->
  <div class="nav-overlay" id="nav-overlay">
    <ul class="nav-overlay__links">
      <li><a href="/">Portfolio</a></li>
      <li><a href="/archive">Archive</a></li>
      <li><a href="/info">Info</a></li>
      <li><a href="/info#contact">Contact</a></li>
    </ul>
  </div>

  <!-- ===================== MAIN ===================== -->
  <main>
    <slot />
  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer">
    <div class="footer__top">
      <span class="footer__logo">
        {settings?.photographerName ?? 'Nome Fotografo'}<em>.</em>
      </span>
      <p class="footer__tagline">
        {settings?.tagline ?? 'Naturalistic & Fine Art Photography'}
      </p>

      <!-- Social: appare solo se il campo è compilato in Sanity -->
      {(settings?.instagram || settings?.linkedin || settings?.facebook) && (
        <div class="footer__socials">
          {settings.instagram && (
            <a
              href={`https://instagram.com/${settings.instagram}`}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label="Instagram"
            >
              <!-- Instagram icon -->
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {settings.linkedin && (
            <a
              href={`https://linkedin.com/in/${settings.linkedin}`}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label="LinkedIn"
            >
              <!-- LinkedIn icon -->
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {settings.facebook && (
            <a
              href={`https://facebook.com/${settings.facebook}`}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label="Facebook"
            >
              <!-- Facebook icon -->
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
        </div>
      )}
    </div>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {new Date().getFullYear()} — Fotografia Naturalistica Professionale
      </p>
      <ul class="footer__nav">
        <li><a href="/">Portfolio</a></li>
        <li><a href="/archive">Archive</a></li>
        <li><a href="/info">Info</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>

<script>
  const navbar  = document.getElementById('navbar');
  const burger  = document.getElementById('nav-burger');
  const overlay = document.getElementById('nav-overlay');

  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('navbar--scrolled', window.scrollY > 80);
  });

  burger?.addEventListener('click', () => {
    const open = overlay?.classList.toggle('nav-overlay--open');
    burger?.classList.toggle('navbar__burger--open', open ?? false);
    document.body.style.overflow = open ? 'hidden' : '';
  });

  overlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      overlay.classList.remove('nav-overlay--open');
      burger?.classList.remove('navbar__burger--open');
      document.body.style.overflow = '';
    });
  });
</script>

<script>
  // ── Fade-in allo scroll ────────────────────────────────────
  // Osserva tutti gli elementi .fade-in e aggiunge .is-visible
  // quando almeno il 10% dell'elemento è entrato nel viewport.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>