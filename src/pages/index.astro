---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/astro/FadeIn.astro';
import { sanityClient } from '../lib/sanity';
import { homePageQuery, settingsQuery } from '../lib/queries';
import type { HomePage, SiteSettings } from '../types/sanity';



const [homePage, settings] = await Promise.all([
  sanityClient.fetch<HomePage>(homePageQuery),
  sanityClient.fetch<SiteSettings>(settingsQuery),
]);

const SHOPIFY_STORE_URL = "https://il-tuo-store.myshopify.com";
---

<Layout
  title="Home | Portfolio Naturalistico"
  description="Fotografia d'arte e stampe fine-art"
>

  <!-- ===================== HERO =====================
       Il testo hero appare subito (no fade-in):
       è above the fold, l'animazione sarebbe fastidiosa. -->
  <header class="hero">
    <p class="hero__eyebrow">Stampe d'autore in edizione limitata</p>
    <h1 class="hero__title">Wild<br/><em>Tales</em></h1>
    <div class="hero__scroll-hint" aria-hidden="true">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </header>

  <!-- ===================== GALLERY ===================== -->
  <section class="gallery">
    <div class="gallery__inner">
      {homePage?.photos?.map((photo, i) => (
        <!--
          Ogni card ha fade-in.
          Le colonne hanno delay alternati così la coppia
          sinistra/destra arriva in leggero sfasamento.
            col sinistra (i pari)  → delay-1
            col destra  (i dispari)→ delay-2
        -->
        <article class={`gallery__item gallery__item--${i % 2 === 1 ? 'offset' : 'normal'} fade-in ${i % 2 === 0 ? 'delay-1' : 'delay-2'}`}>
          <a
            href={photo.shopifyHandle
              ? `${SHOPIFY_STORE_URL}/products/${photo.shopifyHandle}`
              : `/photo/${photo.slug}`}
            target={photo.shopifyHandle ? '_blank' : '_self'}
            rel={photo.shopifyHandle ? 'noopener noreferrer' : undefined}
            class="gallery__link"
          >
            <div class="gallery__img-wrap">
              <img
                src={`${photo.imageUrl}?w=800&q=85&auto=format`} 
                srcset={`
                  ${photo.imageUrl}?w=400&q=80&auto=format 400w,
                  ${photo.imageUrl}?w=800&q=85&auto=format 800w,
                  ${photo.imageUrl}?w=1200&q=85&auto=format 1200w
                `}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={photo.alt || photo.title}
                class="gallery__img"
                loading="lazy"
              />
              <div class="gallery__overlay">
                <span class="gallery__overlay-label">Acquista Stampa →</span>
              </div>
            </div>

            <div class="gallery__meta">
              <div class="gallery__meta-left">
                <h2 class="gallery__title">{photo.title}</h2>
              </div>
              <span class="gallery__cta-text">Shopify →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  {settings && (
    <section class="about">
      <span class="about__bg-word" aria-hidden="true">About</span>

      <div class="about__inner">

        <!-- Foto: entra da sinistra -->
        <div class="about__img-col fade-in from-left">
          <div class="about__img-frame">
            <img
              src={`${settings.portraitUrl}?w=900&auto=format&q=90`}
              alt={settings.portraitAlt ?? `Foto di ${settings.photographerName}`}
              class="about__img"
            />
            <div class="about__img-accent" aria-hidden="true"></div>
          </div>

          {settings.yearsOfExperience && (
            <div class="about__badge">
              <span class="about__badge-num">{settings.yearsOfExperience}+</span>
              <span class="about__badge-label">Anni sul<br/>campo</span>
            </div>
          )}
        </div>

        <!-- Testo: entra dal basso con delay -->
        <div class="about__text-col fade-in delay-2">
          <p class="eyebrow">Chi sono</p>

          <h2 class="about__heading">
            {settings.bioHeading}
            {settings.bioHeadingEm && <><br/><em>{settings.bioHeadingEm}</em></>}
          </h2>

          <div class="about__divider"></div>

          {settings.bio?.map((paragraph: string) => (
            <p class="about__bio">{paragraph}</p>
          ))}

          <div class="about__contacts">
            {settings.email && (
              <div class="about__contact-item">
                <span class="about__contact-label">Email</span>
                <span>{settings.email}</span>
              </div>
            )}
            {settings.baseCity && (
              <div class="about__contact-item">
                <span class="about__contact-label">Base</span>
                <span>{settings.baseCity}</span>
              </div>
            )}
          </div>

          <div class="about__actions">
            <a href="/info" class="btn btn-primary">Scopri di più</a>
            <a href="/info#contact" class="btn btn-ghost">Scrivimi →</a>
          </div>
        </div>

      </div>
    </section>
  )}

  <FadeIn />

</Layout>